DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=north
DB_SSL=false
# TiDB Cloud example: DB_PORT=4000, DB_SSL=true
DATABASE_URL="mysql://root:your_mysql_password@127.0.0.1:3306/north"
# With SSL (TiDB / managed MySQL): append ?sslaccept=strict
# If password contains special characters (@, #, etc.), URL-encode them in DATABASE_URL (@ -> %40)

SEED_ADMIN_PASSWORD=""
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
